NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/laundry_qr?schema=public

# JWT
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Public URL FE dùng để hiển thị trang sau khi scan QR
# QR sẽ encode dạng: ${PUBLIC_WEB_URL}/q/<token>
PUBLIC_WEB_URL=http://localhost:3000

# CORS
CORS_ORIGINS=http://localhost:3000
