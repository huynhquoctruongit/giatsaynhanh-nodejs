// Prisma schema for Laundry QR backend (PostgreSQL / Neon)

generator client {
  provider        = "prisma-client-js"
  // Gộp include thành 1 câu SQL JOIN (giảm số vòng tới DB — quan trọng khi
  // server và DB ở khác region). Bật relationLoadStrategy: "join" theo từng query.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NOTE: Giữ status/role/action ở String để dễ tương thích migration cũ.
// Enum TS ở src/helpers/enums/index.ts làm single source of truth.

// Superadmin quản lý toàn bộ tiệm (tạo tiệm mới, tạo tài khoản admin đầu tiên
// cho tiệm) — tách biệt hoàn toàn khỏi User/shopId/tenant-context, KHÔNG nằm
// trong TENANT_MODELS (src/config/prisma.ts), luôn truy cập qua prismaUnscoped.
model PlatformAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Multi-tenant: 1 Shop = 1 tiệm giặt sấy. Mọi model nghiệp vụ đều gắn shopId
// và được tự động scope qua Prisma Client Extension (src/config/prisma.ts) +
// AsyncLocalStorage (src/helpers/context/tenant-context.ts) — KHÔNG tự thêm
// where/data shopId thủ công trong service, extension đã lo việc đó.
model Shop {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // dùng cho URL công khai web-laundry: /<slug>, /<slug>/dat-don
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Webhook GPM Pay riêng cho tiệm này: POST /api/webhooks/gpmpay/<webhookToken>,
  // ký bằng webhookSecret riêng (GPM Pay cấp khi tiệm tự đăng ký tài khoản riêng).
  // Route webhook cũ (không token) không đọc 2 field này — vẫn dùng
  // env.gpmpay.webhookSecret + BankAccountShopMapping như trước.
  webhookToken  String? @unique
  webhookSecret String?

  users               User[]
  customers           Customer[]
  products            Product[]
  orders              Order[]
  bookings            Booking[]
  bookingItems        BookingItem[]
  orderItems          OrderItem[]
  scanHistories       ScanHistory[]
  suppliers           Supplier[]
  transactions        Transaction[]
  customerDebts       CustomerDebt[]
  supplierDebts       SupplierDebt[]
  inventoryItems      InventoryItem[]
  inventoryLogs       InventoryLog[]
  shifts              Shift[]
  shiftAttendances    ShiftAttendance[]
  settings            ShopSettings?
  bankTransactions    BankTransaction[]
  bankAccountMappings BankAccountShopMapping[]
}

model User {
  id                 String   @id @default(uuid())
  email              String
  password           String
  name               String
  phone              String?
  role               String   @default("STAFF") // ADMIN | STAFF
  permissions        Json     @default("{}") // Record<PermissionKey, boolean>
  orderViewTimeLimit String   @default("unlimited") // unlimited | 1d | 2d | 1w | 10d | 1m | 45d | 3m | 6m
  isActive           Boolean  @default(true)
  fcmToken           String?  // Firebase Cloud Messaging device token
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  orders         Order[]           @relation("CreatedOrders")
  assignedOrders Order[]           @relation("AssignedOrders")
  scanHistories  ScanHistory[]
  transactions   Transaction[]
  inventoryLogs  InventoryLog[]
  openedShifts   Shift[]           @relation("OpenedShifts")
  attendances    ShiftAttendance[]

  // Email không còn unique toàn cục — 2 tiệm khác nhau được phép dùng trùng
  // email (mỗi tiệm là 1 khách hàng thương mại độc lập của bạn).
  @@unique([shopId, email])
  @@index([shopId])
}

model Customer {
  id        String   @id @default(uuid())
  name      String   // KHÔNG cho trùng tên trong cùng 1 tiệm (chính xác) — chặn nhân viên lỡ tạo trùng
  phone     String?  // SĐT không bắt buộc & KHÔNG unique (cho phép trùng / để trống)
  address   String?
  note      String?
  qrToken   String   @unique @default(uuid()) // global unique: trang tra cứu công khai /q/[token] suy ra shop từ token, không cần biết trước tiệm nào
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  orders   Order[]
  bookings Booking[]
  debts    CustomerDebt[]

  @@unique([shopId, name])
  @@index([shopId])
  @@index([qrToken])
}

model Product {
  id               String   @id @default(uuid())
  name             String
  unit             String   @default("cái")
  price            Decimal  @default(0) @db.Decimal(12, 2)
  importPrice      Decimal? @db.Decimal(12, 2)
  costPrice        Decimal? @db.Decimal(12, 2)
  wholesaleEnabled Boolean  @default(false)
  wholesaleTiers   Json?    // WholesaleTier[] = [{ minQty: number; price: number }]
  isActive         Boolean  @default(true)
  hiddenFromBooking Boolean @default(false) // ẩn khỏi web đặt lịch (dịch vụ nội bộ: Phụ thu...)
  sortOrder        Int      @default(0) // độ ưu tiên hiển thị (nhỏ = lên trên); kéo-thả ở màn dịch vụ
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  orderItems OrderItem[]

  @@index([shopId])
  @@index([isActive])
  @@index([sortOrder])
}

model Order {
  id             String    @id @default(uuid())
  code           String
  qrToken        String    @unique // global unique: cùng lý do như Customer.qrToken
  status         String    @default("CREATED") // CREATED | RECEIVED | WASHING | READY | DELIVERED | CANCELLED
  totalAmount    Decimal   @default(0) @db.Decimal(14, 2)
  discountAmount Decimal   @default(0) @db.Decimal(12, 2)
  note           String?
  pickupAt       DateTime?
  deliveredAt    DateTime?
  // Mốc thu tiền. Giao thường: = lúc giao. Đơn NỢ: null (treo, chưa vào lợi nhuận).
  // Lợi nhuận tính theo paidAt → tiền vào đúng ngày khách thanh toán.
  paidAt         DateTime?
  readyAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  createdById String?
  createdBy   User?   @relation("CreatedOrders", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("AssignedOrders", fields: [assignedToId], references: [id])

  items         OrderItem[]
  scanHistories ScanHistory[]

  bookingsAsSource   Booking[] @relation("BookingSource")
  bookingFromConvert Booking?  @relation("BookingConverted")

  @@unique([shopId, code])
  @@index([shopId])
  @@index([status])
  @@index([customerId])
  @@index([createdAt])
  @@index([paidAt])
  @@index([readyAt])
}

model Booking {
  id               String   @id @default(uuid())
  code             String   // BK-yyyymmdd-XXXXX
  status           String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED | CONVERTED
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  sourceOrderId    String?
  sourceOrder      Order?   @relation("BookingSource", fields: [sourceOrderId], references: [id])
  convertedOrderId String?   @unique
  convertedOrder   Order?   @relation("BookingConverted", fields: [convertedOrderId], references: [id])
  phone            String
  address          String
  pickupAt         DateTime?
  deliveryAt       DateTime?
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  items BookingItem[]

  @@unique([shopId, code])
  @@index([shopId])
  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model BookingItem {
  id        String   @id @default(uuid())
  bookingId String
  productId String?
  name      String
  quantity  Int      @default(1)
  weight    Decimal? @db.Decimal(8, 3)
  unitPrice Decimal  @default(0) @db.Decimal(12, 2)

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([bookingId])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String?
  name      String
  quantity  Int      @default(1)
  weight    Decimal? @db.Decimal(8, 3)
  unitPrice Decimal  @default(0) @db.Decimal(12, 2)

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([shopId])
  @@index([orderId])
  @@index([productId])
}

model ScanHistory {
  id        String   @id @default(uuid())
  orderId   String
  userId    String?
  action    String   @default("VIEW") // VIEW | UPDATE_STATUS
  ip        String?
  userAgent String?
  meta      String?  // JSON serialized
  scannedAt DateTime @default(now())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@index([shopId])
  @@index([orderId])
  @@index([userId])
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  address   String?
  email     String?
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  debts SupplierDebt[]

  @@index([shopId])
}

model Transaction {
  id          String   @id @default(uuid())
  type        String   // INCOME | EXPENSE
  category    String   // Tiền điện, Tiền nước, Tiền mặt bằng...
  amount      Decimal  @db.Decimal(14, 2)
  description String?
  date        DateTime @default(now())
  referenceId String?  // optional link to order/supplier
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([type])
  @@index([date])
  @@index([createdById])
}

model CustomerDebt {
  id          String    @id @default(uuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  amount      Decimal   @db.Decimal(14, 2)
  type        String    @default("MONEY") // MONEY | GOODS
  description String?
  dueDate     DateTime?
  isPaid      Boolean   @default(false)
  paidAt      DateTime?
  paidAmount  Decimal?  @db.Decimal(14, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([customerId])
  @@index([isPaid])
}

model SupplierDebt {
  id          String    @id @default(uuid())
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  amount      Decimal   @db.Decimal(14, 2)
  type        String    @default("MONEY") // MONEY | GOODS
  description String?
  dueDate     DateTime?
  isPaid      Boolean   @default(false)
  paidAt      DateTime?
  paidAmount  Decimal?  @db.Decimal(14, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([supplierId])
  @@index([isPaid])
}

model InventoryItem {
  id          String   @id @default(uuid())
  name        String
  unit        String   @default("cái")
  quantity    Decimal  @default(0) @db.Decimal(10, 3)
  minQuantity Decimal? @db.Decimal(10, 3)
  importPrice Decimal? @db.Decimal(12, 2)
  note        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  logs InventoryLog[]

  @@index([shopId])
  @@index([isActive])
}

model InventoryLog {
  id          String        @id @default(uuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])
  type        String        // IMPORT | EXPORT | ADJUST
  quantity    Decimal       @db.Decimal(10, 3)
  unitPrice   Decimal?      @db.Decimal(12, 2)
  note        String?
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([itemId])
  @@index([createdAt])
}

model Shift {
  id         String    @id @default(uuid())
  name       String
  startTime  DateTime  @default(now())
  endTime    DateTime?
  isOpen     Boolean   @default(true)
  note       String?
  openedById String
  openedBy   User      @relation("OpenedShifts", fields: [openedById], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  attendances ShiftAttendance[]

  @@index([shopId])
  @@index([isOpen])
  @@index([createdAt])
}

model ShiftAttendance {
  id        String    @id @default(uuid())
  shiftId   String
  shift     Shift     @relation(fields: [shiftId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  checkIn   DateTime  @default(now())
  checkOut  DateTime?
  note      String?
  createdAt DateTime  @default(now())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([shiftId])
  @@index([userId])
}

// Giao dịch ngân hàng nhận từ GPM Pay (webhook + đối soát REST).
// Chỉ để HIỂN THỊ tiền chuyển khoản — KHÔNG dính vào logic doanh thu/đơn hàng.
// Webhook không có JWT nên shopId được suy ra qua BankAccountShopMapping
// (accountNumber -> shopId) thay vì qua AsyncLocalStorage như các model khác.
model BankTransaction {
  id             String   @id @default(uuid())
  externalId     String   @unique // id giao dịch từ GPM Pay → chống trùng (webhook + REST), global vì id do GPM Pay cấp
  gateway        String? // ngân hàng, vd "MBBank"
  accountNumber  String? // STK nhận tiền
  amount         Decimal  @db.Decimal(14, 2)
  direction      String // IN | OUT
  content        String? // nội dung chuyển khoản
  counterName    String? // tên người chuyển (nếu có)
  counterAccount String? // STK người chuyển (nếu có)
  referenceCode  String?
  source         String? // REAL | SIMULATED
  transactionAt  DateTime // thời điểm giao dịch (từ GPM Pay)
  createdAt      DateTime @default(now())

  shopId String? // null nếu accountNumber chưa được map vào tiệm nào (cần xử lý thủ công)
  shop   Shop?   @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([transactionAt])
  @@index([direction])
}

// Map STK ngân hàng -> tiệm, dùng để resolve shopId cho BankTransaction webhook (không có JWT).
model BankAccountShopMapping {
  id            String @id @default(uuid())
  accountNumber String @unique
  shopId        String
  shop          Shop   @relation(fields: [shopId], references: [id])
}

model ShopSettings {
  id                   String   @id @default(uuid())
  shopName             String   @default("Tiệm Giặt")
  phone                String?
  address              String?
  website              String?
  logo                 String?
  taxCode              String?
  invoiceTemplate      String   @default("default") // default | border | framed | large-text
  invoiceFontSize         Int      @default(14) // 10–22
  customerNameFontSize    Int      @default(22) // prominent customer name
  invoiceShowLogo         Boolean  @default(true)
  invoiceShowShopName     Boolean  @default(true)
  invoiceShowPhone        Boolean  @default(true)
  invoiceShowAddress      Boolean  @default(true)
  invoiceShowWebsite      Boolean  @default(false)
  invoiceShowBarcode      Boolean  @default(true)
  invoiceShowQR           Boolean  @default(true)
  invoiceShowDebt         Boolean  @default(true)
  openingHours            String?  // e.g. "6h30 - 22h00"
  invoiceNote             String?  // ghi chú cuối hoá đơn, riêng theo từng tiệm
  labelTemplate           String?
  labelFontSize           Int      @default(12) // 10–20
  loyaltyEnabled       Boolean  @default(false)
  loyaltyPointsRate    Decimal? @db.Decimal(8, 4)
  deliveryEnabled      Boolean  @default(false)
  deliveryFee          Decimal? @db.Decimal(10, 2)
  bookingShippingFee   Decimal? @db.Decimal(10, 2) // phí ship cộng cho đơn booking khi dưới ngưỡng freeship
  freeShipThreshold    Decimal? @db.Decimal(12, 2) // tổng đơn >= ngưỡng này thì FREESHIP (0/null = luôn tính ship)
  allowNoShiftOrder    Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  shopId String @unique
  shop   Shop   @relation(fields: [shopId], references: [id])
}
