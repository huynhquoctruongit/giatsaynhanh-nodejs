// Prisma schema for Laundry QR backend (PostgreSQL / Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NOTE: Giữ status/role/action ở String để dễ tương thích migration cũ.
// Enum TS ở src/helpers/enums/index.ts làm single source of truth.

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  password           String
  name               String
  phone              String?
  role               String   @default("STAFF") // ADMIN | STAFF
  permissions        Json     @default("{}") // Record<PermissionKey, boolean>
  orderViewTimeLimit String   @default("unlimited") // unlimited | 1d | 2d | 1w | 10d | 1m | 45d | 3m | 6m
  isActive           Boolean  @default(true)
  fcmToken           String?  // Firebase Cloud Messaging device token
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orders         Order[]           @relation("CreatedOrders")
  assignedOrders Order[]           @relation("AssignedOrders")
  scanHistories  ScanHistory[]
  transactions   Transaction[]
  inventoryLogs  InventoryLog[]
  openedShifts   Shift[]           @relation("OpenedShifts")
  attendances    ShiftAttendance[]
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?  @unique // SĐT không bắt buộc; Postgres cho phép nhiều NULL dưới @unique
  address   String?
  note      String?
  qrToken   String   @unique @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders   Order[]
  bookings Booking[]
  debts    CustomerDebt[]

  @@index([qrToken])
}

model Product {
  id               String   @id @default(uuid())
  name             String
  unit             String   @default("cái")
  price            Decimal  @default(0) @db.Decimal(12, 2)
  importPrice      Decimal? @db.Decimal(12, 2)
  costPrice        Decimal? @db.Decimal(12, 2)
  wholesaleEnabled Boolean  @default(false)
  wholesaleTiers   Json?    // WholesaleTier[] = [{ minQty: number; price: number }]
  isActive         Boolean  @default(true)
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderItems OrderItem[]

  @@index([isActive])
}

model Order {
  id             String    @id @default(uuid())
  code           String    @unique
  qrToken        String    @unique
  status         String    @default("CREATED") // CREATED | RECEIVED | WASHING | READY | DELIVERED | CANCELLED
  totalAmount    Decimal   @default(0) @db.Decimal(14, 2)
  discountAmount Decimal   @default(0) @db.Decimal(12, 2)
  note           String?
  pickupAt       DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  createdById String?
  createdBy   User?   @relation("CreatedOrders", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("AssignedOrders", fields: [assignedToId], references: [id])

  items         OrderItem[]
  scanHistories ScanHistory[]

  bookingsAsSource   Booking[] @relation("BookingSource")
  bookingFromConvert Booking?  @relation("BookingConverted")

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model Booking {
  id               String   @id @default(uuid())
  code             String   @unique // BK-yyyymmdd-XXXXX
  status           String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED | CONVERTED
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  sourceOrderId    String?
  sourceOrder      Order?   @relation("BookingSource", fields: [sourceOrderId], references: [id])
  convertedOrderId String?   @unique
  convertedOrder   Order?   @relation("BookingConverted", fields: [convertedOrderId], references: [id])
  phone            String
  address          String
  pickupAt         DateTime?
  deliveryAt       DateTime?
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items BookingItem[]

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model BookingItem {
  id        String   @id @default(uuid())
  bookingId String
  productId String?
  name      String
  quantity  Int      @default(1)
  weight    Decimal? @db.Decimal(8, 3)
  unitPrice Decimal  @default(0) @db.Decimal(12, 2)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String?
  name      String
  quantity  Int      @default(1)
  weight    Decimal? @db.Decimal(8, 3)
  unitPrice Decimal  @default(0) @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model ScanHistory {
  id        String   @id @default(uuid())
  orderId   String
  userId    String?
  action    String   @default("VIEW") // VIEW | UPDATE_STATUS
  ip        String?
  userAgent String?
  meta      String?  // JSON serialized
  scannedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  address   String?
  email     String?
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  debts SupplierDebt[]
}

model Transaction {
  id          String   @id @default(uuid())
  type        String   // INCOME | EXPENSE
  category    String   // Tiền điện, Tiền nước, Tiền mặt bằng...
  amount      Decimal  @db.Decimal(14, 2)
  description String?
  date        DateTime @default(now())
  referenceId String?  // optional link to order/supplier
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([date])
  @@index([createdById])
}

model CustomerDebt {
  id          String    @id @default(uuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  amount      Decimal   @db.Decimal(14, 2)
  type        String    @default("MONEY") // MONEY | GOODS
  description String?
  dueDate     DateTime?
  isPaid      Boolean   @default(false)
  paidAt      DateTime?
  paidAmount  Decimal?  @db.Decimal(14, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([customerId])
  @@index([isPaid])
}

model SupplierDebt {
  id          String    @id @default(uuid())
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  amount      Decimal   @db.Decimal(14, 2)
  type        String    @default("MONEY") // MONEY | GOODS
  description String?
  dueDate     DateTime?
  isPaid      Boolean   @default(false)
  paidAt      DateTime?
  paidAmount  Decimal?  @db.Decimal(14, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([supplierId])
  @@index([isPaid])
}

model InventoryItem {
  id          String   @id @default(uuid())
  name        String
  unit        String   @default("cái")
  quantity    Decimal  @default(0) @db.Decimal(10, 3)
  minQuantity Decimal? @db.Decimal(10, 3)
  importPrice Decimal? @db.Decimal(12, 2)
  note        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logs InventoryLog[]

  @@index([isActive])
}

model InventoryLog {
  id          String        @id @default(uuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])
  type        String        // IMPORT | EXPORT | ADJUST
  quantity    Decimal       @db.Decimal(10, 3)
  unitPrice   Decimal?      @db.Decimal(12, 2)
  note        String?
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([itemId])
  @@index([createdAt])
}

model Shift {
  id         String    @id @default(uuid())
  name       String
  startTime  DateTime  @default(now())
  endTime    DateTime?
  isOpen     Boolean   @default(true)
  note       String?
  openedById String
  openedBy   User      @relation("OpenedShifts", fields: [openedById], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  attendances ShiftAttendance[]

  @@index([isOpen])
  @@index([createdAt])
}

model ShiftAttendance {
  id        String    @id @default(uuid())
  shiftId   String
  shift     Shift     @relation(fields: [shiftId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  checkIn   DateTime  @default(now())
  checkOut  DateTime?
  note      String?
  createdAt DateTime  @default(now())

  @@index([shiftId])
  @@index([userId])
}

model ShopSettings {
  id                   String   @id @default(uuid())
  shopName             String   @default("Tiệm Giặt")
  phone                String?
  address              String?
  website              String?
  logo                 String?
  taxCode              String?
  invoiceTemplate      String   @default("default") // default | border | framed | large-text
  invoiceFontSize         Int      @default(14) // 10–22
  customerNameFontSize    Int      @default(22) // prominent customer name
  invoiceShowLogo         Boolean  @default(true)
  invoiceShowShopName     Boolean  @default(true)
  invoiceShowPhone        Boolean  @default(true)
  invoiceShowAddress      Boolean  @default(true)
  invoiceShowWebsite      Boolean  @default(false)
  invoiceShowBarcode      Boolean  @default(true)
  invoiceShowQR           Boolean  @default(true)
  invoiceShowDebt         Boolean  @default(true)
  openingHours            String?  // e.g. "6h30 - 22h00"
  labelTemplate           String?
  labelFontSize           Int      @default(12) // 10–20
  loyaltyEnabled       Boolean  @default(false)
  loyaltyPointsRate    Decimal? @db.Decimal(8, 4)
  deliveryEnabled      Boolean  @default(false)
  deliveryFee          Decimal? @db.Decimal(10, 2)
  bookingShippingFee   Decimal? @db.Decimal(10, 2) // cộng trên hoá đơn đơn từ booking QR
  allowNoShiftOrder    Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
